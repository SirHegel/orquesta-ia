def cmd_global(a):
    """Reporte global de consumo, en porcentaje, como lo daria cada proveedor."""
    ps = L.cfg().get("profiles", {})
    if a.fijar:
        pid, pct = a.fijar[0], a.fijar[1]
        if pid not in ps:
            print(c("red", f"cuenta desconocida: {pid}")); sys.exit(1)
        try:
            v = float(str(pct).rstrip("%"))
        except ValueError:
            print(c("red", "el porcentaje debe ser un numero")); sys.exit(1)
        if not 0 <= v <= 100:
            print(c("red", "el porcentaje debe estar entre 0 y 100")); sys.exit(1)
        L.cuota_manual_fijar(pid, v, " ".join(a.fijar[2:]))
        print("\n  " + c("g", f"{pid} = {v:.0f}% consumido") +
              c("d", "  (declarado por ti; el router ya lo usa)") + "\n")
        return

    filas, sin_dato = [], []
    for pid, p in ps.items():
        if not L.autenticado(pid, p):
            continue
        g = L.cuota_global(pid, p)
        pct = g.get("pct")
        usd = p.get("plan_usd")
        plan = (p.get("plan") or "") + (f" ${usd}" if usd else "")
        if pct is None:
            detalle = ""
            if g.get("fuente") == "caducado":
                detalle = (f"{g.get('pct_declarado', 0):.0f}% vencido "
                           f"hace {g.get('edad_h', 0):.0f}h")
            sin_dato.append((pid, plan, detalle))
            continue
        col = "red" if pct >= 90 else ("y" if pct >= 70 else "g")
        libre = 100 - pct
        origen = (c("g", "oficial") if g["fuente"] == "proveedor"
                  else c("y", "declarado"))
        edad = ""
        if g["fuente"] == "declarado" and g.get("edad_h") is not None:
            edad = c("d", f"hace {g['edad_h']:.0f}h" if g["edad_h"] >= 1 else "ahora")
        filas.append([pid, plan, origen, c(col, f"{pct:.0f}%"),
                      _barra(pct, 100, 20), c(col, f"{libre:.0f}%"),
                      g.get("reinicia", "")[5:16].replace("T", " ") if g.get("reinicia") else edad])
    tabla([("cuenta", 0), ("plan", 0), ("dato", 0), ("consumido", 1), ("", 0),
           ("libre", 1), ("recarga / edad", 0)], filas, "CONSUMO GLOBAL")

    if sin_dato:
        print("\n  " + c("y", "SIN DATO GLOBAL"))
        for pid, plan, detalle in sin_dato:
            print(f"    {pid:<22} {c('d', plan + ((' · ' + detalle) if detalle else ''))}")
        print("  " + c("d", "estos proveedores no publican el porcentaje. Decláralo tú:"))
        print("  " + c("d", f"    orq global --fijar {sin_dato[0][0]} 97") + "\n")
    else:
        print()

def cmd_score(a):
    if not 0 <= a.nota <= 10: print("nota de 0 a 10"); sys.exit(1)
    pid = a.run_id.rsplit("-",1)[0]
    with L.bloqueo():
        s = L.scores(); s.setdefault(pid,{}).setdefault(a.tarea,{"suma":0,"n":0})
        s[pid][a.tarea]["suma"] += a.nota; s[pid][a.tarea]["n"] += 1
        L._escribir(L.SCORES, s)
    dd = L.scores()[pid][a.tarea]
    print(c("g","registrado") + f": {pid}/{a.tarea} promedio {round(dd['suma']/dd['n'],2)} (n={dd['n']}). El router ya pondera con esto.")

def _set(a, campo, valor):
    with L.bloqueo():
        cf = L.cfg(); p = cf.get("profiles",{}).get(a.id)
        if not p: print(c("red","cuenta desconocida")); sys.exit(1)
        p[campo] = valor; L.guardar_cfg(cf)
    print(c("g", f"{a.id}.{campo} = {valor}"))

