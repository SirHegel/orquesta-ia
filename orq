def cmd_route(a):
    rk = L.ranking(a.tarea, a.proposito)
    if not rk:
        print("\n  " + c("red", f"ninguna cuenta disponible para '{a.tarea}'"))
        for pid in L.cfg().get("profiles", {}):
            b = L.bloqueado(pid)
            if b:
                print("    " + c("y", f"{pid} bloqueada hasta {b.strftime('%H:%M')}"))
        print()
        return
    filas = [[("→ " if i == 0 else "  ") + x["pid"], f"{x['pts']:.2f}", c("d", x["nota"])]
             for i, x in enumerate(rk)]
    t = f"DELEGACION · tarea={a.tarea}" + (f" · proposito={a.proposito}" if a.proposito else "")
    tabla([("cuenta", 0), ("puntaje", 1), ("cupo", 0)], filas, t)
    print("\n  " + c("d", "primero capacidad del motor; despues potencia, rendimiento y cupo") + "\n")

def _elegir(a):
    if a.perfil:
        d = L.disponibles(incluir_bloqueados=True, tarea=a.tarea)
        if a.perfil not in d:
            print(c("red", f"'{a.perfil}' no esta disponible para {a.tarea}")); sys.exit(1)
        return a.perfil, d[a.perfil]
    rk = L.ranking(a.tarea, getattr(a,"proposito",None))
    if not rk: print(c("red","ninguna cuenta disponible (¿todas con limite?)  orq limites")); sys.exit(1)
    return rk[0]["pid"], rk[0]["p"]

def cmd_ask(a):
    pid, p = _elegir(a)
    print(c("d", f"-> {pid} · {p.get('label',pid)}\n"))
    prompt = a.prompt + (BREVE if getattr(a, "corto", False) else "")
    r = L.correr(pid, p, prompt, a.tarea, a.timeout)
    txt = r["texto"] or ""
    lim = getattr(a, "lineas", 0)
    if lim and txt.count("\n") + 1 > lim:
        partes = txt.split("\n")
        print("\n".join(partes[:lim]))
        print(c("d", f"  … {len(partes) - lim} lineas mas. Completo en:  "
                    f"orq ver {r['run_id']}"))
        os.makedirs(os.path.join(L.BASE, "state", "salidas"), exist_ok=True)
        with open(os.path.join(L.BASE, "state", "salidas", r["run_id"] + ".txt"), "w") as f:
            f.write(txt)
    else:
        print(txt)
    extra = c("red", f" LIMITE hasta {r['limitado']}") if r["limitado"] else ""
    pie = "[{0} | {1} tok | {2}s | run_id={3}]".format(r["perfil"], r["tokens"], r["seg"], r["run_id"])
    print("\n" + c("d", pie) + extra)

def _fan(prompt, tarea, timeout, perfiles=None):
    d = L.disponibles(tarea=tarea)
    if perfiles: d = {k:v for k,v in d.items() if k in perfiles}
    if not d: print(c("red","sin cuentas disponibles")); sys.exit(1)
    with ThreadPoolExecutor(max_workers=len(d)) as ex:
        return list(ex.map(lambda kv: L.correr(kv[0], kv[1], prompt, tarea, timeout), d.items()))

def cmd_fan(a):
    for r in _fan(a.prompt, a.tarea, a.timeout, a.perfiles):
        print(c("cy", f"{'='*70}\n{r['perfil']}  ({r['tokens']} tok · {r['seg']}s · {r['run_id']})\n{'='*70}"))
        print(r["texto"], "\n")

def cmd_audit(a):
    d = L.disponibles(tarea=a.tarea)
    revisores = L.disponibles(tarea="review")
    if (not d or not revisores
            or not any(pid != rid for pid in d for rid in revisores)):
        print(c("red", "se necesita una cuenta para responder y otra compatible con review")); sys.exit(1)
    print(c("b", f"FASE 1 · respuestas en paralelo ({', '.join(d)})\n"))
    res = _fan(a.prompt, a.tarea, a.timeout, list(d))
    for r in res:
        print(c("cy", f"--- {r['perfil']} ({r['tokens']} tok · {r['seg']}s) ---"))
        print((r["texto"] or "")[:1800], "\n")
    print(c("b","FASE 2 · auditoria cruzada\n"))
    trab = []
    for rid, rp in revisores.items():
        otros = [x for x in res if x["perfil"] != rid and x["texto"]]
        if not otros: continue
        bloques = "\n\n".join(f"### Respuesta de {o['perfil']}\n{o['texto'][:3000]}" for o in otros)
        pa = (f"Eres auditor tecnico. Pregunta original:\n{a.prompt}\n\n{bloques}\n\n"
              "Para CADA respuesta ajena indica: (1) errores factuales concretos, "
              "(2) omisiones importantes, (3) nota de 0 a 10. Breve y directo.")
        trab.append((rid, rp, pa))
    with ThreadPoolExecutor(max_workers=max(1,len(trab))) as ex:
        auds = list(ex.map(lambda t: L.correr(t[0], t[1], t[2], "review", a.timeout), trab))
    for r in auds:
        print(c("mg", f"--- auditoria por {r['perfil']} ({r['tokens']} tok) ---"))
        print(r["texto"], "\n")
    print(c("b", f"Gasto de esta auditoria: {sum(r['tokens'] for r in res+auds)} tokens "
                 f"({len(res)} respuestas + {len(auds)} auditorias)"))

def cmd_verificar(a):
    """Prueba real: llama a cada cuenta y reporta si responde de verdad."""
    ps = L.cfg().get("profiles", {})
    objetivo = {a.id: ps[a.id]} if a.id else {k: v for k, v in ps.items()
                                             if v.get("enabled", True) and L.autenticado(k, v)}
    if not objetivo:
        print("\n  " + c("red", "nada que verificar") + "\n"); return
    print("\n  " + c("d", f"probando {len(objetivo)} cuenta(s) con una llamada minima..."))
    filas = []
    with ThreadPoolExecutor(max_workers=len(objetivo)) as ex:
        res = list(ex.map(lambda kv: (kv[0], L.correr(
            kv[0], kv[1], "di solo: ok",
            "reasoning" if L.admite_tarea(kv[1], "reasoning") else "imagen", a.timeout)),
                          objetivo.items()))
    for pid, r in res:
        txt = (r["texto"] or "").strip()
        if r["rc"] == 0 and txt and not txt.startswith("[ERROR"):
            est, det = c("g", "RESPONDE"), f'"{txt[:40]}"'
        else:
            est = c("red", "FALLA")
            det = c("d", txt.replace("\n", " ")[:88])
        filas.append([pid, est, f"{r['tokens']:,}", f"{r['seg']}s", det])
    tabla([("cuenta", 0), ("resultado", 0), ("tokens", 1), ("seg", 1), ("detalle", 0)],
          filas, "VERIFICACION REAL")
    print()

def _barra(v, maxv, ancho=22):
    if not maxv:
        return ""
    n = max(1, round(ancho * v / maxv)) if v else 0
    return c("red", "█" * n) + c("d", "·" * (ancho - n))

def cmd_uso(a):
    R = L.resumen_uso()
    print("\n  " + c("b", "RESUMEN DE USO"))
    filas = [["hoy", f"{R['hoy']['tokens']:,}", f"{R['hoy']['llamadas']:,}"],
             ["esta semana", f"{R['semana']['tokens']:,}", f"{R['semana']['llamadas']:,}"],
             ["este mes", f"{R['mes']['tokens']:,}", f"{R['mes']['llamadas']:,}"],
             ["histórico", f"{R['total']['tokens']:,}", f"{R['total']['llamadas']:,}"]]
    tabla([("periodo", 0), ("tokens", 1), ("llamadas", 1)], filas)
    if R.get("sesiones_mes"):
        print("  " + c("d", f"{R['sesiones_mes']} sesiones de terminal distintas este mes"))

    datos = L.uso(a.periodo, a.por, a.n)
    if not datos:
        print("\n  " + c("d", "sin datos para ese periodo") + "\n"); return
    etq = {"dia": "DIA", "semana": "SEMANA", "mes": "MES", "todo": "TOTAL"}[a.periodo]
    for per in sorted(datos, reverse=True):
        g = datos[per]
        maxv = max((v["tokens"] for v in g.values()), default=0)
        total = sum(v["tokens"] for v in g.values())
        filas = []
        for k, v in sorted(g.items(), key=lambda x: -x[1]["tokens"]):
            pct = (100 * v["tokens"] / total) if total else 0
            nom = k if a.por != "sesion" else (k[:17] + ("·" + v["term"] if v["term"] else ""))
            filas.append([nom, f"{v['tokens']:,}", f"{pct:4.1f}%",
                          _barra(v["tokens"], maxv), f"{v['llamadas']:,}",
                          c("red", str(v["errores"])) if v["errores"] else c("d", "0")])
        tabla([(a.por, 0), ("tokens", 1), ("%", 1), ("", 0), ("llam", 1), ("err", 1)],
              filas, f"{etq} {per}   ·   {total:,} tokens")
    print()

BREVE = ("\n\nResponde de forma compacta: ve al grano, sin preambulos ni resumen final. "
         "Usa listas cortas en vez de parrafos. Maximo ~12 lineas.")

