"""orq — orquestador multi-cuenta de IA. Compartido entre todas las terminales."""
import argparse, json, os, re, sys, subprocess, time, datetime, shutil
from concurrent.futures import ThreadPoolExecutor
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import orqlib as L

C = {"r":"\033[0m","b":"\033[1m","d":"\033[2m","g":"\033[32m","y":"\033[33m",
     "red":"\033[31m","cy":"\033[36m","mg":"\033[35m"}
def c(k, s): return f"{C[k]}{s}{C['r']}"

RE_ANSI = re.compile(r"\033\[[0-9;]*m")
def vw(s):  # ancho visible
    return len(RE_ANSI.sub("", str(s)))
def pad(s, n, der=False):
    d = n - vw(s)
    return (" " * d + str(s)) if der else (str(s) + " " * max(0, d))
def tabla(cols, filas, titulo=None):
    """cols = [(encabezado, alineacion_derecha)]"""
    anchos = [max(vw(h), *(vw(f[i]) for f in filas)) if filas else vw(h)
              for i, (h, _) in enumerate(cols)]
    if titulo:
        print("\n" + c("b", titulo))
    print("  " + c("d", "  ".join(pad(h.upper(), anchos[i], cols[i][1])
                                  for i, (h, _) in enumerate(cols))))
    print("  " + c("d", "─" * (sum(anchos) + 2 * (len(cols) - 1))))
    for f in filas:
        print("  " + "  ".join(pad(f[i], anchos[i], cols[i][1]) for i in range(len(cols))))


PESOS_BASE = {"code":8,"agentic":8,"reasoning":8,"review":8,
              "writing":7,"research":7,"edicion":7,"bulk":6}

# ---------- cuentas ----------
def _pill(pid, p):
    if not p.get("enabled", True):  return c("d", "apagada")
    if not L.autenticado(pid, p):   return c("red", "sin autenticar")
    b = L.bloqueado(pid)
    if b:                           return c("y", f"limite→{b.strftime('%H:%M')}")
    return c("g", "activa")

def cmd_cuentas(a):
    ps = L.cfg().get("profiles", {})
    if not ps:
        print("\n  sin cuentas.  " + c("y", "orq cuenta add <id> --provider claude") + "\n")
        return
    filas = []
    for pid, p in ps.items():
        horas = p.get("ventana_horas") or L.VENTANA_PLAN.get(p.get("plan", "desconocido"), 5)
        gv = L.gastado_ventana(pid, horas)
        cupo = p.get("cupo_ventana", 0)
        vent = f"{gv:,}/{cupo:,}" if cupo else f"{gv:,}"
        filas.append([pid, p.get("provider", ""), p.get("plan", ""), _pill(pid, p),
                      p.get("proposito", ""), f"{L.gastado_hoy(pid):,}",
                      vent, f"{horas:g}h"])
    tabla([("cuenta", 0), ("prov", 0), ("plan", 0), ("estado", 0), ("proposito", 0),
           ("hoy", 1), ("ventana", 1), ("recarga", 1)], filas, "CUENTAS")
    ext = L.sesiones_externas()
    if ext:
        filas = []
        for prov, ss in sorted(ext.items()):
            for x in ss:
                filas.append([prov, x["pid"], f"{x['segundos']//60} min", x["cmd"][:52]])
        tabla([("proveedor", 0), ("pid", 1), ("activa", 1), ("comando", 0)], filas,
              "TERMINALES TUYAS TRABAJANDO AHORA")
        if any(prov in L.SERIALIZAR for prov in ext):
            print("  " + c("y", "aviso") + c("d", ": esos CLIs no admiten llamadas en paralelo; "
                  "Orquesta serializa las suyas para no chocar."))
    faltan = [(pid, p) for pid, p in ps.items() if not L.autenticado(pid, p)]
    if faltan:
        print("\n  " + c("y", "PARA AUTENTICAR"))
        for pid, p in faltan:
            print(f"    {c('b', pid)}\n      {c('d', L.cmd_login(pid, p))}")
    print()

def cmd_cuenta_add(a):
    if not L.id_perfil_valido(a.id):
        print(c("red", "id invalido: usa minusculas, numeros, guion o guion bajo")); sys.exit(1)
    with L.bloqueo():
        cf = L.cfg(); ps = cf.setdefault("profiles", {})
        if a.id in ps and not a.force:
            print(c("red", f"'{a.id}' ya existe (usa --force para sobreescribir)")); sys.exit(1)
        if (a.provider == "antigravity" and any(
                p.get("provider") == "antigravity" for k, p in ps.items()
                if k != a.id)):
            print(c("red", "Antigravity usa una sesion global; ya existe un perfil")); sys.exit(1)
        home = os.path.expanduser(a.home) if a.home else os.path.join(L.ACCOUNTS, a.id)
        os.makedirs(home, exist_ok=True); os.chmod(home, 0o700)
        ps[a.id] = {"label": a.label or f"{a.provider} · {a.id}",
                    "provider": a.provider, "home": home,
                    "plan": a.plan, "ventana_horas": a.ventana,
                    "cupo_ventana": a.cupo, "proposito": a.proposito,
                    "enabled": True, "budget_tokens_dia": a.budget,
                    "weights": dict(PESOS_BASE)}
        if a.provider == "antigravity":
            ps[a.id]["allowed_tasks"] = ["imagen"]
            ps[a.id]["power"] = {"imagen": 10}
            ps[a.id]["weights"] = {"imagen": 10}
        else:
            ps[a.id]["allowed_tasks"] = [t for t in L.TAREAS if t != "imagen"]
            ps[a.id]["power"] = 10
        if a.model: ps[a.id]["model"] = a.model
        L.guardar_cfg(cf)
    print(c("g", f"cuenta '{a.id}' creada") + f"  ({a.provider}, home={home})")
    print(f"\n{c('b','Ahora autentícala corriendo esto:')}\n  {L.cmd_login(a.id, L.cfg()['profiles'][a.id])}\n")

def cmd_cuenta_login(a):
    ps = L.cfg().get("profiles", {})
    if a.id not in ps: print(c("red","cuenta desconocida")); sys.exit(1)
    print(f"{c('b','Corre esto en tu terminal:')}\n  {L.cmd_login(a.id, ps[a.id])}\n")
    print(c("d","(el login es interactivo; no puedo hacerlo por ti — nunca manejo tus contraseñas)"))

def cmd_cuenta_key(a):
    """Guarda una API key leyendola de stdin: nunca pasa por argv ni por el historial."""
    ps = L.cfg().get("profiles", {})
    pr = ps.get(a.id)
    if not pr:
        print(c("red", "cuenta desconocida")); sys.exit(1)
    h = L.home_de(a.id, pr)
    os.makedirs(h, exist_ok=True); os.chmod(h, 0o700)
    destino = os.path.expanduser(pr.get("api_key_file") or os.path.join(h, "api_key"))
    print(c("d", "pega la API key y dale Enter (no se muestra en pantalla):"))
    import getpass
    try:
        k = getpass.getpass("  key> ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\n" + c("y", "cancelado")); sys.exit(1)
    if len(k) < 20:
        print(c("red", "esa clave parece demasiado corta; no la guardo")); sys.exit(1)
    fd = os.open(destino, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(k)
    with L.bloqueo():
        cf = L.cfg(); cf["profiles"][a.id]["auth"] = "apikey"
        cf["profiles"][a.id]["api_key_file"] = destino
        L.guardar_cfg(cf)
    print(c("g", f"guardada en {destino} (modo 600, fuera de git)"))
    print(c("d", "compruébala con:  orq verificar --id " + a.id))

def cmd_cuenta_rm(a):
    with L.bloqueo():
        cf = L.cfg()
        p = cf.get("profiles", {}).pop(a.id, None)
        if not p: print(c("red","cuenta desconocida")); sys.exit(1)
        L.guardar_cfg(cf)
    print(c("g", f"'{a.id}' eliminada del registro"))
    h = L.home_de(a.id, p)
    if a.purge and h.startswith(L.ACCOUNTS):
        shutil.rmtree(h, ignore_errors=True); print(c("y", f"credenciales borradas: {h}"))
    else:
        print(c("d", f"credenciales conservadas en {h} (usa --purge para borrarlas)"))

def cmd_cuenta_toggle(a):
    with L.bloqueo():
        cf = L.cfg(); p = cf.get("profiles", {}).get(a.id)
        if not p: print(c("red","cuenta desconocida")); sys.exit(1)
        p["enabled"] = (a.c == "enable"); L.guardar_cfg(cf)
    print(c("g", f"'{a.id}' {'activada' if a.c=='enable' else 'desactivada'}"))

# ---------- estado / auditoria de gasto ----------
def cmd_status(a):
    cmd_cuentas(a)
    rows = L.ledger_rows()
    if not rows:
        print("  " + c("d", "sin llamadas registradas todavia") + "\n")
        return
    filas = []
    for pid in sorted({r["perfil"] for r in rows}):
        rs = [r for r in rows if r["perfil"] == pid]
        tk = sum(r.get("tokens", 0) for r in rs)
        sg = sum(r.get("seg", 0) for r in rs) / max(1, len(rs))
        filas.append([pid, f"{len(rs):,}", f"{tk:,}", f"{tk // max(1, len(rs)):,}", f"{sg:.1f}"])
    tabla([("cuenta", 0), ("llamadas", 1), ("tokens", 1), ("tok/llam", 1), ("seg medio", 1)],
          filas, "GASTO")
    tot = sum(r.get("tokens", 0) for r in rows)
    print("\n  " + c("d", f"total {tot:,} tokens en {len(rows)} llamadas"))
    s_ = L.scores()
    if s_:
        fl = []
        for pid, t in s_.items():
            for k, v in t.items():
                if v.get("n"):
                    fl.append([pid, k, f"{v['suma'] / v['n']:.1f}", str(v["n"])])
        if fl:
            tabla([("cuenta", 0), ("tarea", 0), ("nota", 1), ("muestras", 1)],
                  fl, "RENDIMIENTO MEDIDO")
    print()

