def cmd_proyecto(a):
    carpeta = os.path.abspath(os.path.expanduser(a.en or os.getcwd()))
    ctx_term = ""
    if getattr(a, "contexto", None) and os.path.exists(a.contexto):
        try:
            ctx_term = open(a.contexto).read()[:4000]
        except OSError:
            pass
    print("\n  " + c("b", "PROYECTO") + "  " + c("d", carpeta))
    print("  " + c("d", a.prompt[:150]) + "\n")

    print("  " + c("y", "1 · plan") + c("d", " · pensando la arquitectura…"), flush=True)
    plan, err = L.planificar(a.prompt, carpeta, a.timeout)
    if err:
        print("  " + c("red", err) + "\n"); sys.exit(1)

    asignacion = None
    if not a.sin_deliberar and len(L.disponibles(tarea="reasoning")) > 1:
        print("  " + c("y", "2 · consenso") + c("d", " · las IA deciden quien hace que…"), flush=True)
        asignacion, motivo = L.deliberar(plan, a.prompt, a.timeout)
        print("  " + c("d", "   " + (motivo or "")))

    filas = []
    for t in plan["tareas"]:
        tipo = t.get("tipo", "code")
        pid = (asignacion or {}).get(t["id"])
        if not pid:
            r = L.ranking(tipo if tipo in L.TAREAS else "code")
            pid = r[0]["pid"] if r else c("red", "sin cuenta")
        filas.append([t["id"], t.get("titulo", "")[:36], tipo, pid,
                      ",".join(t.get("depende") or []) or c("d", "—")])
    tabla([("id", 0), ("tarea", 0), ("tipo", 0), ("la hace", 0), ("tras", 0)], filas,
          f"PLAN · {plan.get('nombre','?')} · por {plan['_planificador']}")
    print("  " + c("d", plan.get("resumen", "")))
    if plan.get("_aviso"):
        print("  " + c("y", "ajuste") + c("d", " · " + plan["_aviso"]))
    olas = L._ordenar_por_olas(plan["tareas"])
    print("  " + c("d", f"{len(plan['tareas'])} tareas · hasta "
                       f"{max((len(o) for o in olas), default=1)} IA a la vez · "
                       f"cada una arranca en cuanto puede"))

    if not a.si:
        try:
            if input("\n  ¿Ejecuto? [s/N] ").strip().lower() not in ("s", "si", "sí", "y"):
                print("  cancelado\n"); return
        except (EOFError, KeyboardInterrupt):
            print("\n  cancelado\n"); return

    t0 = time.time()

    def cb(ev, d):
        t = time.time() - t0
        if ev == "empieza":
            print(f"  {c('d', f'{t:6.0f}s')} {c('y', '▸')} {d['titulo'][:42]:<44}"
                  f"{c('d', d['perfil'])}", flush=True)
        else:
            marca = c("g", "✔") if not d["rc"] else c("red", "✘")
            print(f"  {c('d', f'{t:6.0f}s')} {marca} {d['titulo'][:42]:<44}"
                  f"{c('d', d['perfil'])}  "
                  f"{c('d', f'{d[chr(116)+chr(111)+chr(107)+chr(101)+chr(110)+chr(115)]:,} tok')}",
                  flush=True)

    print("\n  " + c("y", "3 · construccion") + c("d", " · integra segun terminan\n"))
    res = L.ejecutar_proyecto(plan, carpeta, a.timeout, cb, asignacion, ctx_term)

    if not a.sin_auditar and len(L.disponibles(tarea="review")) > 1:
        print("\n  " + c("y", "4 · auditoria cruzada")
              + c("d", " · cada modelo revisa lo ajeno…\n"), flush=True)

        def cba(ev, d):
            if ev == "auditoria":
                print("  " + c("d", "   auditan: " + ", ".join(d["cuentas"])), flush=True)
            else:
                marca = c("g", "✔") if not d["rc"] else c("red", "✘")
                print(f"\n  {marca} {c('mg', d['perfil'])} "
                      f"{c('d', f'({d[chr(116)+chr(111)+chr(107)+chr(101)+chr(110)+chr(115)]:,} tok)')}")
                print(envolver_simple(d["texto"], "     "))

        auds, err = L.auditar_proyecto(plan, carpeta, res, a.timeout, cba,
                                       arreglar=not a.sin_arreglar)
        if err:
            print("  " + c("d", err))
        for x in auds:
            res.append({"titulo": f"auditoria de {x['perfil']}", "perfil": x["perfil"],
                        "tokens": x["tokens"], "seg": x["seg"], "rc": x["rc"]})

    if not a.sin_integrar:
        print("\n  " + c("y", "5 · cierre") + c("d", " · revision e integracion final…"), flush=True)
        fin_ = L.integrar_proyecto(plan, carpeta, res, a.timeout)
        if fin_:
            print(envolver_simple(fin_["texto"] or "", "     "))
            res.append({"titulo": "cierre", "perfil": fin_["perfil"],
                        "tokens": fin_["tokens"], "seg": fin_["seg"], "rc": fin_["rc"]})

    tot = sum(r["tokens"] for r in res) + plan.get("_tokens_plan", 0)
    porq = {}
    for r in res:
        if r.get("perfil"):
            porq[r["perfil"]] = porq.get(r["perfil"], 0) + r["tokens"]
    print("\n  " + c("b", "LISTO") + c("d", f"  ·  {tot:,} tokens  ·  {time.time()-t0:.0f}s"))
    mx = max(porq.values()) if porq else 0
    for k, v in sorted(porq.items(), key=lambda x: -x[1]):
        print(f"    {k:<22} {v:>10,}  {_barra(v, mx, 16)}")
    try:
        n = len([f for f in os.listdir(carpeta) if not f.startswith(".")])
        print("  " + c("d", f"{n} archivos en {carpeta}"))
    except OSError:
        pass
    print()


def envolver_simple(txt, sangria="  "):
    import textwrap
    out = []
    for l in (txt or "").split("\n")[:12]:
        out += [sangria + x for x in (textwrap.wrap(l, 96) or [""])]
    return "\n".join(out)


def cmd_cuota(a):
    ps = L.cfg().get("profiles", {})
    filas = []
    for pid, p in ps.items():
        if not L.autenticado(pid, p):
            continue
        q = L.cuota(pid, p)
        if q.get("fuente") == "proveedor":
            pct = q.get("usado_pct") or 0
            col = "red" if pct >= 80 else ("y" if pct >= 50 else "g")
            barra = _barra(pct, 100, 18)
            filas.append([pid, c("g", "OFICIAL"), c(col, f"{pct:.0f}%"), barra,
                          f"{(q.get('ventana_min') or 0)//60}h",
                          (q.get("reinicia") or "?")[:16].replace("T", " ")])
        else:
            det = f"{q.get('facturable', 0):,} tok"
            if q.get("plan_real"):
                det += f" · {q['plan_real']}"
            filas.append([pid, c("y", "estimado"), c("d", "?"), c("d", det),
                          f"{q.get('ventana_horas', 5):g}h", c("d", "—")])
    tabla([("cuenta", 0), ("dato", 0), ("usado", 1), ("detalle", 0),
           ("ventana", 1), ("recarga", 0)], filas, "CUOTA REAL")
    print("\n  " + c("g", "OFICIAL") + c("d", " = el proveedor publica el porcentaje exacto."))
    print("  " + c("y", "estimado") + c("d", " = calculado leyendo TODAS las sesiones de esta maquina"))
    print("  " + c("d", "              (no incluye lo que uses desde el movil, la web u otro equipo)") + "\n")

